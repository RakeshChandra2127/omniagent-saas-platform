# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://root:secret@localhost:27017/omniagent?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Configuration
WA_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
WA_APP_SECRET=your_whatsapp_app_secret_here
